# Defaults for the endpoint fields. Both are editable at runtime in the UI and
# saved to localStorage, so you only need this file to change what a fresh
# browser profile starts with.

# --- Local Xiaozhi server ---
VITE_OTA_URL=http://localhost:8003/xiaozhi/ota/
VITE_WS_URL=ws://localhost:8000/xiaozhi/v1/

# --- Production (bcserver.xyz) ---
# Note: nginx serves these subdomains on port 80 only, so they are ws:// not
# wss://. A page served over https will refuse to open a plain ws:// socket —
# run the simulator over http when pointing at these.
# VITE_OTA_URL=http://mini-8003.bcserver.xyz/xiaozhi/ota/
# VITE_WS_URL=ws://mini-8000.bcserver.xyz/xiaozhi/v1/
